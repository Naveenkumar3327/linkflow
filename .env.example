# Base URL used to construct the shortened URL response (e.g., https://your-backend.onrender.com)
# Defaults to http://localhost:8000 in local dev; falls back to RENDER_EXTERNAL_URL if set on Render.
BASE_URL=http://localhost:8000

# SQLite database file path (relative or absolute)
# In local development: data/urls.db
# In production on Render with persistent disk: /var/data/urls.db
DATABASE_PATH=data/urls.db

# Allowed frontend origin(s) for strict CORS (comma-separated if multiple)
# In production, set to your exact Vercel frontend URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Length of generated random short codes (default: 6)
CODE_LENGTH=6

# Server port (automatically provided by Render / hosting environments)
PORT=8000
